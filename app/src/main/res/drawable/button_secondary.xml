<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#E6E1E9"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#C8C4CC"/>
            <padding android:left="20dp" android:top="14dp" android:right="20dp" android:bottom="14dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="@color/primary"/>
            <padding android:left="20dp" android:top="14dp" android:right="20dp" android:bottom="14dp"/>
        </shape>
    </item>
</selector>